[1967.629836, "o", "\u001b[?2004h\u001b[?1049h\u001b[22;0;0t\u001b[1;24r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[39;49m\u001b[?1h\u001b=\u001b[?1h\u001b=\u001b[?25l\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J\u001b[22;35H\u001b(B\u001b[0;7m[ Чтение… ]\u001b(B\u001b[m\u001b[22;30H\u001b(B\u001b[0;7m[ Прочитано 58 строк ]\u001b(B\u001b[m\u001b[H\u001b(B\u001b[0;7m  GNU nano 7.2                        README.md                                 \u001b[1;79H\u001b(B\u001b[m\r\u001b[23d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Справка   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Записать  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Поиск     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Вырезать  \u001b(B\u001b[0;7m^T\u001b(B\u001b[m Выполнить \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Позиция\r\u001b[24d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Выход     \u001b(B\u001b[0;7m^R\u001b(B\u001b[m ЧитФайл   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Замена    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Вставить  \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Выровнять \u001b(B\u001b[0;7m^/\u001b(B\u001b[m К строке"]
[1967.630113, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Лабиринт\r\u001b[4d\u001b[39m\u001b(B\u001b[mТекстовая приключенческая игра, в которой вы исследуете таинственный лабиринт,\r\u001b[5dрешаете загадки и ищете легендарное сокровище.\r\u001b[7d\u001b(B\u001b[0;1m\u001b[33m## Установка\r\u001b[9d\u001b[39m\u001b(B\u001b[mmake install\r\u001b[11d\u001b(B\u001b[0;1m\u001b[33m### Запуск\r\u001b[13d\u001b[39m\u001b(B\u001b[mmake project\r\u001b[15d\u001b(B\u001b[0;1m\u001b[33m#### Описание игры \r\u001b[17d\u001b[39m\u001b(B\u001b[mИгрок исследует таинственный лабиринт, решает загадки, собирает предметы\r\u001b[18dи пытается найти легендарное сокровище.\r\u001b[20d\u001b(B\u001b[0;1m\u001b[33m##### Команды\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
